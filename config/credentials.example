# Copy to .env in the repository root; fill credentials locally, never in Git.
# Plain KEY=value, single/double quotes and comments are supported.
# Values are literal: no shell commands or ${VARIABLE} expansion.
DATABASE_URL=
SUPABASE_URL=https://hltlwyjsaxredjxdhwhy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=original-pdfs
MISTRAL_API_KEY=
# Optional public progress JWT; polling works without it.
SUPABASE_ANON_KEY=
# Bounded database connections per backend process; overflow is disabled.
DB_POOL_SIZE=2
DB_POOL_TIMEOUT=5
